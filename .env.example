# Development values. Replace these for any public deployment.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web
DJANGO_CSRF_TRUSTED_ORIGINS=
CACHE_URL=redis://cache:6379/1

# Production example (set DJANGO_DEBUG=0 and configure a real HTTPS host):
# DJANGO_DEBUG=0
# DJANGO_ALLOWED_HOSTS=perfume.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://perfume.example.com
# DJANGO_USE_X_FORWARDED_PROTO=1
# DJANGO_EMAIL_HOST=smtp.example.com
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_HOST_USER=your-smtp-user
# DJANGO_EMAIL_HOST_PASSWORD=your-smtp-password
# DJANGO_EMAIL_USE_TLS=1
# DJANGO_DEFAULT_FROM_EMAIL=orders@perfume.example.com
